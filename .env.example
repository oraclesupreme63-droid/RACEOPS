# Application
RACEOPS_ENV=local
RACEOPS_LOG_LEVEL=INFO
RACEOPS_API_PORT=8000

# PostgreSQL — development values only
RACEOPS_DATABASE_URL=postgresql+psycopg://raceops:raceops@localhost:55432/raceops
RACEOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_DB=raceops
POSTGRES_USER=raceops
POSTGRES_PASSWORD=raceops
POSTGRES_PORT=55432

# Authentication — replace before any deployed environment
RACEOPS_JWT_SECRET=replace-with-a-long-random-secret
RACEOPS_ACCESS_TOKEN_TTL_MINUTES=15

# JSON array consumed by Pydantic Settings
RACEOPS_CORS_ORIGINS=["http://localhost:3000"]

